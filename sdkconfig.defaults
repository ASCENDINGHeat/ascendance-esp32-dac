CONFIG_IDF_TARGET="esp32s3"

# Flash configuration for 16MB Flash (N16)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# PSRAM configuration for 8MB Octal PSRAM (R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Default PCM5102A I2S Pin Mapping
CONFIG_EXAMPLE_I2S_LCK_PIN=4
CONFIG_EXAMPLE_I2S_DIN_PIN=5
CONFIG_EXAMPLE_I2S_BCK_PIN=6

# TinyUSB and WebHID Configuration
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=y
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4002
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_PRODUCT_STRING="ESP32-S3 Hi-Fi DSP DAC"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Ascension Audio"

